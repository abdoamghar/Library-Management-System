<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <span class="eyebrow">A WORLD ON YOUR SHELVES</span>
    <h1>The collection<span class="heading-dot">.</span></h1>
    <p>
      <%= search ? `Results for “${search}”` : 'Find a familiar favourite. Make room for something new.' %>
    </p>
  </div>
  <a class="button" href="/books/new">+ Add a book</a>
</div>
<div class="list-toolbar">
  <span>
    <strong><%= paging.count %></strong>
    <%= search ? 'matching titles' : 'books in your collection' %>
  </span><% if (search) { %><a class="text-link" href="/books">Clear search ×</a><% } else { %><span
    class="muted">Arranged by
    title</span><% } %>
</div>
<% if (!books.length) { %>
<div class="empty-state">
  <h2><%= search ? 'No books found' : 'Your next chapter starts here' %></h2>
  <p>
    <%= search ? 'Try another title or clear your search.' : 'Add your first book to start building the collection.' %>
  </p>
  <a class="button" href="<%= search ? '/books' : '/books/new' %>">
    <%= search ? 'View all books' : 'Add a book' %></a>
</div>
<% } %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% books.forEach((book, index) => { %>
  <article class="book-card">
    <a class="book-cover cover-<%= index % 6 %>" href="/books/<%= book._id %>"
      aria-label="View <%= book.title %>">
      <span class="cover-label">CHAPTER HOUSE
        COLLECTION</span>
      <span class="cover-title"><%= book.title %></span>
      <span class="cover-line"></span>
      <span class="cover-author">
        <%= book.authors.map(author => author.name).join(' & ') || 'Author not assigned' %></span>
      <span class="cover-year"><%= book.publicationYear %></span>
    </a>
    <div class="book-info">
      <div class="flex justify-between items-start gap-3">
        <span class="muted">
          <%= book.categories.map(category => category.name).join(' · ') || 'Uncategorised' %>
        </span>
        <span class="badge <%= book.availableCopies ? '' : 'badge-warm' %>">
          <%= book.availableCopies ? 'Available' : 'On loan' %></span>
      </div>
      <h3>
        <a href="/books/<%= book._id %>"><%= book.title %></a>
      </h3>
      <p><%= book.authors.map(author => author.name).join(', ') || 'Author not assigned' %></p>
      <div class="book-bottom">
        <span><%= book.availableCopies %>
          of
          <%= book.totalCopies %>
          copies available</span>
        <a class="text-link" href="/books/<%= book._id %>">View book ↗</a>
      </div>
    </div>
  </article>
  <% }); %>
</div>
<%- include('../partials/pagination') %><%- include('../partials/footer') %>
