<%- include('../partials/header') %><a class="text-link" href="/books">← Back to collection</a>
<div class="book-detail">
  <div class="book-cover cover-1 detail-cover">
    <span class="cover-label">CHAPTER HOUSE COLLECTION</span>
    <span class="cover-title"><%= book.title %></span>
    <span class="cover-line"></span>
    <span class="cover-author">
      <%= book.authors.map(a => a.name).join(' & ') || 'Author not assigned' %></span>
    <span class="cover-year"><%= book.publicationYear %></span>
  </div>
  <section>
    <span class="eyebrow"><%= book.categories.map(c => c.name).join(' · ') || 'UNCATEGORISED' %>
    </span>
    <h1><%= book.title %></h1>
    <p class="detail-author">
      By <%= book.authors.map(a => a.name).join(', ') || 'Author not assigned' %>
    </p>
    <p class="detail-description">
      <%= book.description || 'No description has been added yet.' %>
    </p>
    <dl class="detail-meta">
      <div>
        <dt>Publication</dt>
        <dd><%= book.publicationYear %></dd>
      </div>
      <div>
        <dt>ISBN</dt>
        <dd><%= book.isbn %></dd>
      </div>
      <div>
        <dt>Copies available</dt>
        <dd>
          <%= book.availableCopies %>
          /
          <%= book.totalCopies %>
        </dd>
      </div>
    </dl>
    <div class="flex flex-wrap gap-3 mt-6">
      <% if (book.availableCopies) { %><a class="button" href="/loans/new?book=<%= book._id %>">Lend
        this book ↗</a><% } %><a class="button button-light" href="/books/<%= book._id %>/edit">Edit
        book</a>
      <form method="post" action="/books/<%= book._id %>/delete"
        data-confirm="Delete this book and all its returned borrowing history? Books with active loans cannot be deleted.">
        <input type="hidden" name="_csrf" value="<%= csrf %>" />
        <button class="button button-danger" type="submit">
          Delete
        </button>
      </form>
    </div>
  </section>
</div>
<section class="panel">
  <h2>Recent borrowing history</h2>
  <% if (!loans.length) { %>
  <p class="empty-inline">This book is waiting for its first reader.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Reader</th>
          <th>Borrowed</th>
          <th>Due</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% loans.forEach(loan => { %>
        <tr>
          <td><%= loan.borrowerName %></td>
          <td><%= loan.borrowedAt.toLocaleDateString('en-GB') %></td>
          <td><%= loan.dueAt.toLocaleDateString('en-GB') %></td>
          <td>
            <span class="badge"><%= loan.returnedAt ? 'Returned' : 'On loan' %></span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
