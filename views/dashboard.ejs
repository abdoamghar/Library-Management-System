<%- include('partials/header') %>
<section class="hero">
  <div>
    <span class="eyebrow">THE LIBRARY, AT A GLANCE</span>
    <h1>Every book.<br />A new beginning.</h1>
    <p>
      Keep your shelves organised, your stories circulating,
      <br class="desktop-break" />
      and your community reading.
    </p>
    <div class="flex flex-wrap gap-3 mt-6">
      <a class="button" href="/books">Explore the collection <span>↗</span>
      </a>
      <a class="button button-light" href="/loans/new">Lend a book</a>
    </div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="art-orbit"></div>
    <div class="art-book book-one">
      <span>THE ART
        <br />OF
        <br />READING
      </span>
      <small>A WORLD WITHIN</small>
    </div>
    <div class="art-book book-two">
      <span>One more
        <br />chapter.
      </span>
      <small>CHAPTER HOUSE</small>
    </div>
    <span class="art-caption">Stories live here.</span>
  </div>
</section>
<section class="stats-grid" aria-label="Library statistics">
  <% for (const card of statCards) { %>
  <div class="stat">
    <span><%= card.label %></span>
    <strong><%= card.value %></strong>
    <small><%= card.note %></small>
  </div>
  <% } %>
</section>
<div class="section-heading">
  <div>
    <span class="eyebrow">BETWEEN THE COVERS</span>
    <h2>Your library in numbers</h2>
  </div>
  <span class="muted">Live from your collection</span>
</div>
<div class="charts-grid">
  <section class="panel">
    <h3>Books by category</h3>
    <p class="muted">A book may appear on more than one shelf.</p>
    <div class="chart-box">
      <canvas id="category-chart" role="img" aria-label="Book count by category"></canvas>
    </div>
    <% if (!chartData.categories.labels.length) { %>
    <p class="muted">Add books with categories to see the chart.</p>
    <% } %>
    <details>
      <summary>View chart data</summary>
      <ul>
        <% chartData.categories.labels.forEach((label, i) => { %>
        <li>
          <%= label %>:
          <%= chartData.categories.values[i] %>
        </li>
        <% }); %>
      </ul>
    </details>
  </section>
  <section class="panel">
    <h3>Borrowing activity</h3>
    <p class="muted">Loans recorded over the last six months.</p>
    <div class="chart-box">
      <canvas id="activity-chart" role="img" aria-label="Monthly borrowing activity"></canvas>
    </div>
    <details>
      <summary>View chart data</summary>
      <ul>
        <% chartData.activity.labels.forEach((label, i) => { %>
        <li>
          <%= label %>:
          <%= chartData.activity.values[i] %>
          loans
        </li>
        <% }); %>
      </ul>
    </details>
  </section>
</div>
<section class="panel mt-6">
  <div class="section-heading compact">
    <div>
      <h3>Next books due</h3>
      <p class="muted">A little attention keeps the stories moving.</p>
    </div>
    <a class="text-link" href="/loans">Borrowing desk →</a>
  </div>
  <% if (!recent.length) { %>
  <p class="empty-inline">No books on loan. Your shelves are ready for readers.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Book</th>
          <th>Reader</th>
          <th>Due date</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(loan => { %>
        <tr>
          <td>
            <a href="/books/<%= loan.book?._id %>"><%= loan.book?.title || 'Removed book' %></a>
          </td>
          <td><%= loan.borrowerName %></td>
          <td><%= loan.dueAt.toLocaleDateString('en-GB') %></td>
          <td>
            <span class="badge <%= loan.dueAt < new Date() ? 'badge-warm' : '' %>">
              <%= loan.dueAt < new Date() ? 'Overdue' : 'On loan' %></span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<script id="chart-data" type="application/json">
  <%- JSON.stringify(chartData).replace(/</g, '\\u003c') %>

</script>
<script src="/vendor/chart.js" defer></script>
<script src="/js/dashboard.js" defer></script>
<%- include('partials/footer') %>
