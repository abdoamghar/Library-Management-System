<%- include('../partials/header') %><a class="text-link" href="/<%= kind %>">← Back to
  <%= kind %></a>
<div class="page-heading">
  <div>
    <span class="eyebrow">MAKE ROOM ON THE SHELVES</span>
    <h1><%= title %><span class="heading-dot">.</span></h1>
  </div>
</div>
<form class="panel library-form narrow-form" method="post"
  action="/<%= kind %><%= item._id ? '/' + item._id : '' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>" /><%- include('../partials/errors') %><label
    for="name">Name <span>*</span>
  </label>
  <input id="name" name="name" required maxlength="<%= kind === 'authors' ? 100 : 60 %>"
    value="<%= item.name || '' %>" autofocus />
  <label for="detail"><%= kind === 'authors' ? 'Biography' : 'Description' %></label><textarea id="detail" name="<%= detail %>" rows="5" maxlength="<%= kind === 'authors' ? 1500 : 300 %>">
<%= item[detail] || '' %></textarea>
  <div class="form-actions">
    <button class="button" type="submit">Save <%= singular.toLowerCase() %></button>
    <a class="button button-light" href="/<%= kind %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
