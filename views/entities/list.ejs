<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <span class="eyebrow">
      <%= kind === 'authors' ? 'THE PEOPLE BEHIND THE PAGES' : 'A PLACE FOR EVERY STORY' %></span>
    <h1><%= title %><span class="heading-dot">.</span></h1>
    <p>
      <%= search ? `Results for “${search}”` : kind === 'authors' ? 'Meet the voices that make your collection.' : 'Organise the collection into welcoming shelves.' %>
    </p>
  </div>
  <a class="button" href="/<%= kind %>/new">+ Add <%= singular.toLowerCase() %></a>
</div>
<div class="list-toolbar">
  <span>
    <strong><%= paging.count %></strong> records
  </span><% if (search) { %><a class="text-link" href="/<%= kind %>">Clear search ×</a><% } %>
</div>
<% if (!items.length) { %>
<div class="empty-state">
  <h2>
    No
    <%= kind %>
    found
  </h2>
  <p>
    <%= search ? 'Try another name or clear your search.' : 'Add your first record to get started.' %>
  </p>
</div>
<% } %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  <% items.forEach(item => { %>
  <article class="entity-card">
    <span class="entity-initial" aria-hidden="true"><%= item.name.slice(0, 1) %></span>
    <div class="entity-body">
      <h2><%= item.name %></h2>
      <span class="badge"><%= countMap[String(item._id)] || 0 %> books</span>
      <p><%= item[detail] || 'No description yet.' %></p>
      <div class="flex gap-4 items-center">
        <a class="text-link" href="/<%= kind %>/<%= item._id %>/edit">Edit
          <%= singular.toLowerCase() %> ↗</a>
        <form method="post" action="/<%= kind %>/<%= item._id %>/delete"
          data-confirm="Delete this <%= singular.toLowerCase() %>? Related books will be kept and this reference removed.">
          <input type="hidden" name="_csrf" value="<%= csrf %>" />
          <button class="delete-link" type="submit">
            Delete
          </button>
        </form>
      </div>
    </div>
  </article>
  <% }); %>
</div>
<%- include('../partials/pagination') %><%- include('../partials/footer') %>
